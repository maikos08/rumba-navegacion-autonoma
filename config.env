# =====================================================================
#  Configuración pública del proyecto Rumba (iRobot Create 2)
#  Formato: CLAVE=valor   (líneas que empiezan por # son comentarios)
#  Es el único sitio donde hay que tocar números: el código no tiene
#  constantes "mágicas". Cualquier clave se puede sobrescribir con una
#  variable de entorno RUMBA_<CLAVE>, p. ej.  set RUMBA_PUERTO=COM7
#  Unidades: mm, mm/s, s y grados (salvo que se indique otra cosa).
# =====================================================================

# --- Conexión -------------------------------------------------------
PUERTO=COM5                 # puerto serie del robot (Administrador de dispositivos)
HTTP_HOST=127.0.0.1         # solo accesible desde este equipo
HTTP_PORT=8000              # puerto de la página web de control
ABRIR_NAVEGADOR=1           # 1: abre el navegador al arrancar, 0: no

# --- Geometría y odometría (especificación Open Interface) ----------
B=235.0                     # distancia entre ruedas (mm)
DIAMETRO_RUEDA=72.0         # diámetro de rueda (mm)
CUENTAS_POR_VUELTA=508.8    # cuentas de encoder por vuelta de rueda
R_ROBOT=174                 # radio del robot (mm), Ø 348,5 mm
PERIODO=0.05                # s entre lecturas (la spec pide no bajar de 15 ms)
MIN_PASO=10.0               # mm mínimos entre puntos guardados del camino

# --- Teleoperación --------------------------------------------------
V_AVANCE=150                # mm/s al avanzar (también velocidad máxima al ir al objetivo)
V_GIRO=100                  # mm/s en cada rueda al girar sobre sí mismo

# --- Ir a un objetivo -----------------------------------------------
V_AVANCE_MIN=50             # mm/s mínima al acercarse
V_GIRO_MIN=40               # mm/s mínima al girar (por debajo apenas se mueve)
K_GIRO=200                  # mm/s por rad de error al girar sobre sí mismo
K_CORR=150                  # mm/s por rad de error para corregir el rumbo avanzando
TOL_DIST=10                 # mm: distancia a la que se considera alcanzado el objetivo
DIST_FINAL=100              # mm: en el tramo final ya no se vuelve a girar
ANG_OK_GRADOS=5             # error de rumbo para pasar de girar a avanzar
ANG_MAX_GRADOS=20           # error de rumbo para volver a girar mientras avanza
TOL_GIRO_GRADOS=1.5         # precisión de las instrucciones "Girar" del circuito

# --- Light bumpers (valores 0-4095; dependen del color/material) ----
IR_LENTO=80                 # sensores delanteros por encima: empieza a frenar
IR_FRENTE=600               # sensores delanteros por encima: obstáculo delante
FACTOR_MIN=0.2              # fracción mínima de velocidad al frenar por IR
IR_OBJETIVO=300             # valor lateral que se intenta mantener junto a la pared
IR_PERDIDA=40               # por debajo de esto se considera perdida la pared

# --- Modo "parar ante obstáculos" -----------------------------------
IR_PARADA=50                # sensores delanteros por encima: se para
IR_LIBRE=30                 # por debajo: se considera que el obstáculo se ha ido
ESPERA_LIBRE=1.0            # s que debe estar libre antes de continuar

# --- Seguimiento de contorno / pared --------------------------------
LADO=-1                     # -1: pared a la IZQUIERDA (gira a la derecha); +1: al revés
V_CONTORNO=100              # mm/s al seguir el contorno
K_PARED=0.08                # mm/s por unidad de error IR
CORR_MAX=60                 # mm/s de corrección máxima
V_BUSCAR=50                 # mm/s al buscar la pared perdida
V_ARCO=25                   # mm/s de diferencia por rueda al buscar la pared
RETRO_CONTORNO=50           # mm que retrocede si choca siguiendo el contorno
ANG_APARTARSE_GRADOS=30     # cuánto gira para apartarse tras chocar

# --- Condiciones del algoritmo Bug2 ---------------------------------
TOL_LINEA=30                # mm: distancia a la línea M para considerarse sobre ella
MEJORA=50                   # mm: cuánto más cerca del objetivo que H para dejar el contorno
SEP_H=200                   # mm: distancia mínima a H para poder dejar el contorno
RADIO_H=300                 # mm: si vuelve a esta distancia de H, dio la vuelta completa
LEJOS_H=800                 # mm que debe alejarse de H antes de que la vuelta cuente
CONTORNO_MAX=40000          # mm máximos siguiendo paredes en un trayecto
TIEMPO_MAX=600              # s máximos por trayecto

# --- Modo limpieza (chocayvuelve): recorrer la habitación al azar ----
LIMPIEZA_ANG_MIN_GRADOS=90  # giro mínimo (al azar, izquierda o derecha) tras un obstáculo
LIMPIEZA_ANG_MAX_GRADOS=180 # giro máximo
LIMPIEZA_RETRO=50           # mm que retrocede tras un choque con el parachoques
LIMPIEZA_CHOQUES_ATASCO=3   # choques seguidos sin avanzar que activan la maniobra de escape
LIMPIEZA_LIBRE=300          # mm recorridos sin obstáculos para dar por resuelto un atasco
ATASCO_TIEMPO=10            # s: si en este tiempo se mueve menos de ATASCO_DIST, está atascado
ATASCO_DIST=150             # mm
SEMILLA=0                   # semilla del azar (0: distinto en cada ejecución; otro número: repetible)

# --- Modo seguir_pared (seguirpared) --------------------------------
PARED_PERDIDA_TIEMPO=15     # s sin ver la pared antes de volver a buscar otra
